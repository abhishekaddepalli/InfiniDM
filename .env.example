APP_NAME=InstaMagic
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=instaflow
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=database

ADMIN_NAME="Site Admin"
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=

ALLOW_REGISTRATION=true

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_GRAPH_VERSION=v23.0

INSTAGRAM_REDIRECT_URI="${APP_URL}/instagram/connect/callback"

NODE_WEBHOOK_TOKEN=
SERVER_URL=http://127.0.0.1:3100
NODE_PORT=3100

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Demo lock — blocks sensitive writes (password / admin settings / credentials)
DEMO_MODE=false
DEMO_MESSAGE="This action is disabled in the demo."
