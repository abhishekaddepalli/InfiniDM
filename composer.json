{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "infiniforge/infinidm",
    "type": "project",
    "description": "InfiniDM — Instagram DM automation, flows, broadcasts and marketing engine by Infiniforge Technologies.",
    "keywords": ["instagram", "automation", "dm", "flows"],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "doctrine/dbal": "^4.4",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^2.9",
        "league/flysystem-aws-s3-v3": "^3.0",
        "minishlink/web-push": "^11.0",
        "pusher/pusher-php-server": "^7.2",
        "smalot/pdfparser": "^2.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "kkomelin/laravel-translatable-string-exporter": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Support/fc_helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan storage:link --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
