# ---------------------------------------------------------------------------
# Instaflow Node runtime config — SAME keys as WaDesk's node/.env
# Copy to node/.env and fill in:   cp .env.example .env
# ---------------------------------------------------------------------------

# The port THIS node worker listens on (WaDesk: PORT). Any free port. Default 3001.
PORT=3001

# This node's own URL (self, on the port above). WaDesk: DOMAIN_NAME.
DOMAIN_NAME=http://localhost:3001

# YOUR LARAVEL WEBSITE URL — what you type in the browser to open Instaflow.
# NOT the node port. WaDesk calls this APP_DOMAIN_NAME.
# e.g. http://SERVER_IP:8008   or   https://your-instaflow-domain.com
APP_DOMAIN_NAME=http://127.0.0.1:8000

# Shared secret between Node and Laravel (X-Node-Token).
# Must match: admin -> Instagram settings -> Node token.
NODE_WEBHOOK_TOKEN=change-this-to-a-long-random-secret

# Logs. Default = ON (you want to watch the worker). Set to "off" to run quiet.
INSTAFLOW_LOGS=on
